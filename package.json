{
  "name": "dsh-comfy-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "node scripts/build-client.ts",
    "dsh:profile": "node scripts/dsh.ts profile",
    "dsh:start": "node scripts/dsh.ts start",
    "dsh:config": "node scripts/dsh.ts config",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "check": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "devDependencies": {
    "@cs/catalog": "workspace:*",
    "@cs/project": "workspace:*",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "lightningcss": "1.33.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vitest": "5.1.2"
  }
}
