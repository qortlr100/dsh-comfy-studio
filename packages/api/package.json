{
  "name": "@cs/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "View API: authenticated routes that let browser views read a project's state, run operations as the human, move through the history and manage projects, and a server-sent event stream of project changes. Ported from DreamVerse @dv/api (MIT).",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./wire": "./src/wire.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cs/catalog": "workspace:*",
    "@cs/project": "workspace:*",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "24.19.2"
  }
}
