{
  "name": "@cs/catalog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Generation catalog: the provider-neutral csCatalog registry that generation provider plugins register one entry per place a request can run into, and the contract of an entry (facts, validation, run events). The frame follows DreamVerse @dv/models (MIT).",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./testing/fake-provider": "./src/testing/fake-provider.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cs/project": "workspace:*",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "24.19.2"
  }
}
